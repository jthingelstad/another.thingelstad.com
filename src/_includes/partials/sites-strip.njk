{#- The sites strip that opens every one of Jamie's sites. The markup
    is the shared contract in thingelstad.com/AGENTS.md ("The sites strip"):
    sites with in_sites_strip true, in file order, from the vendored
    src/_data/sites.json (npm run sites:sync). Every site, the current one
    (site.id) included, reads as its strip_label, so the strip says the same
    on every site; the current site differs only in its class and
    aria-current. Every link carries ?ref=sites-strip-<this site> so
    Tinylytics' Sources report on the destination shows the visits this
    strip sent. -#}
<nav class="sites-strip" aria-label="Jamie Thingelstad">
  <div class="sites-strip__inner">
    <span class="sites-strip__label">Jamie Thingelstad</span>
    <ul class="sites-strip__list">
      {%- for s in sites.sites %}{% if s.in_sites_strip %}
      {%- set current = s.id == site.id %}
      <li class="sites-strip__item sites-strip__item--{{ s.id | escape }}{% if current %} sites-strip__item--current{% endif %}">
        <a href="{{ s.url | escape }}?ref=sites-strip-{{ site.id | escape }}" title="{{ s.description | escape }}"{% if current %} aria-current="true"{% endif %}>{{ s.strip_label | escape }}</a>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</nav>
