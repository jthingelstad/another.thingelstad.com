---
# URLs from the micro.blog deployment that no longer exist here (src/_data/legacyRedirects.js).
# CloudFront answers each with a real 301 (src/redirects-map.11ty.js), so these stub pages, written
# for GitHub Pages (which had no server redirects), are never reached; the hosting test checks the
# map against them.
pagination:
  data: legacyRedirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
eleventyExcludeFromCollections: true
---
{%- set target = site.url + redirect.to + (redirect.anchor or "") -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Moved</title>
<link rel="canonical" href="{{ site.url }}{{ redirect.to }}">
<meta http-equiv="refresh" content="0; url={{ target }}">
</head>
<body>
<p>This page moved to <a href="{{ target }}">{{ target }}</a>.</p>
</body>
</html>
