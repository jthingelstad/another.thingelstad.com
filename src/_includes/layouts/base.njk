<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.shortDescription }}">

    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} podcast feed" href="{{ site.url }}/podcast.xml">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS feed" href="{{ site.url }}/feed.xml">
    <link rel="alternate" type="text/markdown" title="LLM-friendly site index" href="{{ site.url }}/llms.txt">
    <link rel="alternate" type="application/json" title="JSON episode index" href="{{ site.url }}/index.json">
    {% if episode.llmPermalink %}<link rel="alternate" type="text/markdown" title="Plain-text version of this episode" href="{{ site.url }}{{ episode.llmPermalink }}">{% endif %}

    <meta property="og:type" content="{% if ogType %}{{ ogType }}{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
    <meta property="og:description" content="{{ description or site.shortDescription }}">
    {#- An episode shares its card from cards.thingelstad.com, drawn from the
        page's h-entry; ?v= changes when its title, date, summary, number or
        running time does. #}
    {%- if episode and page.url == episode.permalink %}
    <meta property="og:image" content="https://cards.thingelstad.com/another{{ episode.permalink | replace('.html', '') }}.png?v={{ [episode.title, episode.publishDate, episode.summary, episode.number, episode.durationSeconds | round] | cardVersion }}">
    {%- else %}
    <meta property="og:image" content="{{ site.url }}{{ ogImage or site.coverImage }}">
    {%- endif %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta name="twitter:card" content="summary_large_image">

    {% for me in sites.owner.rel_me %}<link rel="me" href="{{ me }}">
    {% endfor %}
    <link rel="icon" href="/assets/images/favicon.svg?v=2" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/uploads/2025/another-thing-3000.png">

    {# The type every one of Jamie's sites shares: Inter and Inter Tight,
       self-hosted, and the --jt- tokens (assets/css/shared/, vendored from
       thingelstad.com shared/ by npm run sites:sync). #}
    <link rel="preload" href="/assets/css/shared/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/css/shared/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/css/shared/tokens.css">
    <link rel="stylesheet" href="/assets/css/main.css">
  </head>
  <body class="{{ bodyClass }}">
    {% include "partials/sites-strip.njk" %}
    {% include "partials/header.njk" %}
    <main id="main">
      {{ content | safe }}
    </main>
    {% include "partials/footer.njk" %}
    <script src="/assets/js/player.js" defer></script>
    <script defer src="https://tinylytics.app/embed/dU_bEtHmyUV_xnbDz6zH.js?kudos&countries"></script>
  </body>
</html>
