---
layout: layouts/base.njk
ogType: article
---
<article class="episode h-entry" data-pagefind-body>
  <header class="episode__header">
    <p class="episode__eyebrow">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      Episode {{ episode.number }} · <time class="dt-published" datetime="{{ episode.publishDate | isoDate }}">{{ episode.publishDate | readableDate }}</time>{% if episode.durationSeconds %} · {{ episode.durationSeconds | friendlyDuration }}{% endif %}
    </p>
    <h1 class="episode__title p-name">{{ episode.title }}</h1>
    {#- The episode as an h-entry (IndieWeb), which the card maker
        (cards.thingelstad.com) reads to draw its share card. #}
    <data class="u-url" value="{{ site.url }}{{ episode.permalink }}"></data>
    {% if episode.summary %}<p class="episode__summary p-summary">{{ episode.summary }}</p>{% endif %}
  </header>

  {% include "partials/player.njk" %}

  {% if episode.notesMarkdown %}
    <section class="episode__notes prose e-content">
      {{ episode.notesMarkdown | renderMarkdown | safe }}
    </section>
  {% endif %}

  <aside class="episode__aside">
    {% if episode.transcriptText %}
      <a class="link-button" href="#transcript">Jump to transcript</a>
    {% endif %}
    <a class="link-button" target="_blank" rel="noopener" href="https://thingy.thingelstad.com/chat/?explore={{ (site.url + episode.permalink) | urlencode }}&amp;ref=another-episode" data-tinylytics-event="episode.explore" data-tinylytics-event-value="{{ episode.number }}">&#10024; Explore with Thingy</a>
    <a class="link-button" href="/subscribe/">Subscribe</a>
    <button type="button" class="tinylytics_kudos" aria-label="Send kudos for this episode"></button>
  </aside>

  {% if episode.transcriptText %}
    <section id="transcript" class="episode__transcript">
      <header class="episode__transcript-header">
        <p class="eyebrow"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span> Transcript</p>
        <h2 class="episode__transcript-title">Transcript</h2>
      </header>
      <div class="prose episode__transcript-body">
        {{ episode.transcriptText | paragraphs | safe }}
      </div>
    </section>
  {% endif %}
</article>
