{
  "name": "another-thingelstad-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Another Thing podcast website, built with Eleventy",
  "scripts": {
    "build": "eleventy && pagefind --site _site",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "sites:sync": "node scripts/sync-sites.mjs",
    "sites:check": "node scripts/sync-sites.mjs --check",
    "test": "node --test",
    "infra:generate": "node infra/templates.mjs",
    "infra": "node scripts/infra.mjs",
    "deploy:aws": "node scripts/deploy-aws.mjs",
    "audio:put": "node scripts/put-audio.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@aws-sdk/client-acm": "^3.1157.0",
    "@aws-sdk/client-cloudformation": "^3.1157.0",
    "@aws-sdk/client-cloudfront": "^3.1157.0",
    "@aws-sdk/client-eventbridge": "^3.1157.0",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/client-sts": "^3.1157.0",
    "luxon": "^3.5.0",
    "markdown-it": "^15.0.1",
    "music-metadata": "^11.15.0",
    "pagefind": "^1.1.1"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2",
    "brace-expansion": "5.0.12"
  }
}
