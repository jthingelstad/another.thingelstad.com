---
layout: layouts/base.njk
permalink: /index.html
# The page is an h-feed (IndieWeb): named by the hero title, an h-entry for
# the latest episode and each recent one. Its sections are main's children,
# so the root is <main> itself.
mainClass: h-feed
eleventyComputed:
  episode: "{{ episodes[0] }}"
---
<section class="hero">
  <div class="hero__inner">
    <div class="hero__art">
      <img src="{{ site.coverImage }}" alt="Another Thing podcast artwork" width="600" height="600">
    </div>
    <div class="hero__copy">
      <p class="hero__eyebrow"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span> A podcast</p>
      <h1 class="hero__title p-name">{{ site.title }}</h1>
      <p class="hero__tagline">{{ site.shortDescription }}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="{{ episodes[0].permalink }}">Listen to the latest episode</a>
        <a class="button" href="/subscribe/">Subscribe</a>
      </div>
    </div>
  </div>
</section>

<section class="latest">
  <div class="latest__header">
    <h2 class="section-title">Latest episode</h2>
    <a href="/archive/" class="section-link">All episodes →</a>
  </div>

  {% set episode = episodes[0] %}
  <article class="latest__card h-entry">
    <header>
      <p class="card__eyebrow">Episode {{ episode.number }} · <time class="dt-published" datetime="{{ episode.publishDate | isoDate }}">{{ episode.publishDate | readableDate }}</time>{% if episode.durationSeconds %} · {{ episode.durationSeconds | friendlyDuration }}{% endif %}</p>
      <h3 class="card__title p-name"><a class="u-url" href="{{ episode.permalink }}">{{ episode.title }}</a></h3>
      <p class="card__summary p-summary">{{ episode.summary }}</p>
    </header>
    {% include "partials/player.njk" %}
  </article>
</section>

{% if episodes.length > 1 %}
<section class="more">
  <h2 class="section-title">Recent episodes</h2>
  <ul class="episode-list">
    {% for episode in episodes.slice(1, 6) %}
      <li class="episode-list__item h-entry">
        <a class="episode-list__link u-url" href="{{ episode.permalink }}">
          <span class="episode-list__number">#{{ episode.number }}</span>
          <span class="episode-list__title p-name">{{ episode.title }}</span>
          <span class="episode-list__meta"><time class="dt-published" datetime="{{ episode.publishDate | isoDate }}">{{ episode.publishDate | readableDate("LLL d, yyyy") }}</time>{% if episode.durationSeconds %} · {{ episode.durationSeconds | friendlyDuration }}{% endif %}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

<section class="family">
  <h2 class="section-title">More from Jamie</h2>
  <p class="family__intro">Another Thing is one of Jamie's sites.</p>
  <ul class="family__list">
    {#- Jamie's other strip sites, in sites.json order (thingelstad.com/AGENTS.md). -#}
    {% for s in sites.sites %}{% if s.in_sites_strip and s.id != site.id %}
      <li>
        <a href="{{ s.url }}?ref={{ site.id }}-family">
          <strong>{{ s.strip_label or s.name }}</strong>
          <span>{{ s.description }}</span>
        </a>
      </li>
    {% endif %}{% endfor %}
  </ul>
</section>
